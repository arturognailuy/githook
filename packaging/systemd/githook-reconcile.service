[Unit]
Description=Reconcile the newest eligible Githook run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/githook/worker.conf
EnvironmentFile=%h/.config/githook/runtime.conf
ExecStart=%h/.local/bin/githook reconcile
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.githook %h/.local/share/githook
