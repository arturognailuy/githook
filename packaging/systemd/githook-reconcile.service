[Unit]
Description=Reconcile the newest eligible Githook run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/githook/worker.conf
Environment=GITHOOK_SMOKE_URLS=https://gnailuy.com/health.txt,https://gnailuy.com/
ExecStart=%h/.local/bin/githook reconcile
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.githook %h/www/gnailuy
