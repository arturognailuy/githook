[Unit]
Description=Githook deployment worker
After=network-online.target githook-receiver.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/githook/worker.conf
Environment=GITHOOK_SMOKE_URLS=https://gnailuy.com/health.txt,https://gnailuy.com/
ExecStart=%h/.local/bin/githook worker
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.githook %h/www/gnailuy

[Install]
WantedBy=default.target
